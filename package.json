{
  "name": "acme-sponsor-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "db:generate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:setup": "docker compose up -d --wait postgres && npm run db:migrate && npm run admin:bootstrap -- --local-defaults",
    "admin:bootstrap": "tsx --env-file=.env scripts/bootstrap-admin.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "smoke:devnet": "tsx --env-file=.env scripts/devnet-smoke.ts",
    "check:custody-signing": "node --import tsx scripts/check-custody-signing.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.104",
    "@nuxt/ui": "^4.10.0",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.8",
    "ripple-binary-codec": "^2.9.0",
    "ripple-keypairs": "^3.0.0",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^24.10.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.2.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.7"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "packageManager": "npm@11.12.1"
}
