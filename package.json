{
  "name": "acme-sponsor-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:setup": "docker compose up -d --wait postgres && npm run db:migrate && npm run admin:bootstrap -- --local-defaults",
    "admin:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "smoke:devnet": "tsx --env-file-if-exists=.env scripts/devnet-smoke.ts",
    "example:payment": "node --env-file-if-exists=.env examples/devnet-payment.mjs",
    "check:custody-signing": "node --import tsx scripts/check-custody-signing.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "ripple-address-codec": "^5.0.1",
    "ripple-binary-codec": "^2.11.0",
    "ripple-keypairs": "^3.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.11.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "nuxt": "4.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.10"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "packageManager": "npm@11.12.1"
}
