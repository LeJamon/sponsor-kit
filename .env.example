# Application
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_DEFAULT_NETWORK=devnet

# PostgreSQL and authentication
DATABASE_URL=postgres://acme:acme@localhost:5432/acme
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
ACME_GRANT_SECRET=replace-with-a-separate-at-least-32-random-bytes

# Optional password reset delivery. Reset requests stay disabled until all
# values for one provider are present. Use either the generic HTTP transport:
# ACME_PASSWORD_RESET_EMAIL_PROVIDER=http
# ACME_PASSWORD_RESET_EMAIL_URL=https://mailer.example/send
# ACME_PASSWORD_RESET_EMAIL_SECRET=replace-with-mailer-bearer-secret
# For local-only HTTP testing against loopback, also set:
# ACME_PASSWORD_RESET_ALLOW_INSECURE_HTTP=true
# or Resend:
# ACME_PASSWORD_RESET_EMAIL_PROVIDER=resend
# ACME_PASSWORD_RESET_RESEND_API_KEY=re_...
# Both providers require a verified sender address.
# ACME_PASSWORD_RESET_EMAIL_FROM=ACME <no-reply@example.com>

# Optional bootstrap override. Local databases default to admin@acme.local.
# Non-local databases require explicit values and a unique password.
# ACME_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# ACME_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-16-characters
# ACME_BOOTSTRAP_ADMIN_NAME=ACME Administrator

# XRPL network
ACME_XRPL_RPC_URL=https://s.devnet.rippletest.net:51234/
# Comma-separated allowlist. Startup and signing fail closed on any other wire definition set.
ACME_XRPL_DEFINITIONS_HASHES=1EA05B0FC11101F7C500BD0DAC794A8BC746A7FBA6250B75489603EB820E0FF5
ACME_EMBEDDED_WORKER=true

# Backend-only local signer. Never prefix these with NUXT_PUBLIC_.
ACME_LOCAL_SPONSOR_SEED=
ACME_LOCAL_SPONSOR_ADDRESS=
ACME_ALLOW_LOCAL_SIGNER_ON_MAINNET=false
